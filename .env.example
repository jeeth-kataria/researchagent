GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MAX_OUTPUT_TOKENS=2048
MAX_UPLOAD_MB=4
MAX_TEXT_CHARS=20000
MAX_MODEL_REQUESTS_PER_VISIT=3
MAX_TOOL_CALLS_PER_VISIT=2
MAX_TOTAL_MODEL_REQUESTS=13
MAX_SOURCE_CHARS_PER_ROLE=4800

# Larger critic, still Groq; no automatic provider/model fallback.
GROQ_REVIEWER_MODEL=openai/gpt-oss-120b
PDF_EXTRACTION_MODE=layout
# Set a long random access token before sharing a deployment.
RESEARCH_ACCESS_TOKEN=
# Best-effort per-client-address throttle, per server instance.
MAX_REQUESTS_PER_MINUTE=3
# Optional USD per million tokens, keyed by exact model ID: input/output rates.
# Populate from current provider pricing; estimates are not actual bills.
TOKEN_PRICES_JSON={}
